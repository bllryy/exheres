require cmake

SUMMARY="Qt6 configuration tool for desktops without Qt integration"
HOMEPAGE="https://www.opencode.net/trialuser/qt6ct/"
DOWNLOADS="https://www.opencode.net/api/v4/projects/5459/packages/generic/qt6ct/${PV}/${PNV}.tar.xz"

LICENCES="BSD-2"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        x11-libs/qttools:6[linguist]

    build+run:
        x11-libs/qtbase:6[gui]

    run:
        x11-libs/qtsvg:6
"

DEFAULT_SRC_PREPARE_PATCHES=(
    "${FILES}/${PNV}-qt-6.10.patch"
)

src_install() {
    cmake_src_install

    hereenvd 98${PN} <<EOF
QT_QPA_PLATFORMTHEME=qt5ct
EOF
}

pkg_postinst() {
    einfo "QT_QPA_PLATFORMTHEME=qt5ct enables qt6ct after re-login."
    einfo "Avoid qt6ct on desktops with their own Qt integration, such as Plasma."
}
