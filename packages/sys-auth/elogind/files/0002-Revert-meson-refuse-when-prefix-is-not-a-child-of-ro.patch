Source: Timo Gurr <tgurr@exherbo.org>
Upstream: No (I'm not sure since we also sed some rootprefix stuff in src_prepare). Needs investigation.
Reason: Fix build on Exherbo

From f904730d683010b8dd21d5098a6a30ae463e026c Mon Sep 17 00:00:00 2001
From: Timo Gurr <tgurr@exherbo.org>
Date: Wed, 31 Mar 2021 15:48:28 +0200
Subject: [PATCH] Revert "meson: refuse when prefix is not a child of
 rootprefix"

This reverts commit d895e10a24f65d2b016d20d5fb5ecf7ac625c698.
---
 meson.build | 5 -----
 1 file changed, 5 deletions(-)

diff --git a/meson.build b/meson.build
index 6a474afdac..85a6de55f2 100644
--- a/meson.build
+++ b/meson.build
@@ -115,11 +115,6 @@ prefixdir = get_option('prefix')
 if not prefixdir.startswith('/')
         error('Prefix is not absolute: "@0@"'.format(prefixdir))
 endif
-if prefixdir != rootprefixdir and not prefixdir.startswith(rootprefixdir.strip('/') + '/')
-        error('Prefix is not below root prefix (now rootprefix=@0@ prefix=@1@)'.format(
-                rootprefixdir, prefixdir))
-endif
-
 bindir = prefixdir / get_option('bindir')
 libdir = prefixdir / get_option('libdir')
 sysconfdir = prefixdir / get_option('sysconfdir')
-- 
2.31.1

