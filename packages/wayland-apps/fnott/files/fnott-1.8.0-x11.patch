--- /dev/null
+++ b/x11.c
@@ -0,0 +1,202 @@
+#include "x11.h"
+#ifdef FNOTT_ENABLE_X11
+#include <X11/Xutil.h>
+#include <X11/Xatom.h>
+#include <X11/extensions/Xrandr.h>
+#include <string.h>
+
+#define LOG_MODULE "x11"
+#define LOG_ENABLE_DBG 0
+#include "log.h"
+#include <stdlib.h>
+#include <sys/epoll.h>
+
+struct x11 {
+    Display *display;
+    struct fdm *fdm;
+    struct notif_mgr *mgr;
+    const struct config *conf;
+    bool output_warning;
+};
+
+static bool
+on_event(struct fdm *fdm, int fd, int events, void *data)
+{
+    struct x11 *x = data;
+    if (events & EPOLLHUP)
+        return false;
+    while (XPending(x->display)) {
+        XEvent event;
+        XNextEvent(x->display, &event);
+        if (event.type == Expose && event.xexpose.count == 0)
+            notif_mgr_x11_event(x->mgr, event.xany.window, 0);
+        else if (event.type == ButtonPress)
+            notif_mgr_x11_event(x->mgr, event.xany.window, event.xbutton.button);
+    }
+    return true;
+}
+
+struct x11 *
+x11_init(const struct config *conf, struct fdm *fdm, struct notif_mgr *mgr)
+{
+    struct x11 *x = calloc(1, sizeof(*x));
+    if (x == NULL)
+        return NULL;
+    x->display = XOpenDisplay(NULL);
+    if (x->display == NULL) {
+        free(x);
+        return NULL;
+    }
+    /* The shared renderer produces native ARGB32; core XPutImage on a
+     * 24-bit TrueColor screen consumes its RGB channels without conversion. */
+    int screen = DefaultScreen(x->display);
+    Visual *visual = DefaultVisual(x->display, screen);
+    if (DefaultDepth(x->display, screen) != 24 || visual->class != TrueColor ||
+        visual->red_mask != 0xff0000 || visual->green_mask != 0xff00 ||
+        visual->blue_mask != 0xff) {
+        XCloseDisplay(x->display);
+        free(x);
+        return NULL;
+    }
+    x->conf = conf;
+    x->fdm = fdm;
+    x->mgr = mgr;
+    if (!fdm_add(fdm, ConnectionNumber(x->display), EPOLLIN, on_event, x)) {
+        XCloseDisplay(x->display);
+        free(x);
+        return NULL;
+    }
+    return x;
+}
+
+void
+x11_flush(struct x11 *x)
+{
+    XFlush(x->display);
+}
+
+void
+x11_destroy(struct x11 *x)
+{
+    fdm_del_no_close(x->fdm, ConnectionNumber(x->display));
+    XCloseDisplay(x->display);
+    free(x);
+}
+
+void
+x11_hide(struct x11 *x, Window window)
+{
+    XDestroyWindow(x->display, window);
+}
+
+Window
+x11_show(struct x11 *x, Window window, struct buffer *buf, int y)
+{
+    Display *d = x->display;
+    int screen = DefaultScreen(d);
+    const struct config *c = x->conf;
+    int ox = 0, oy = 0;
+    int width = DisplayWidth(d, screen), height = DisplayHeight(d, screen);
+    bool found = false, fallback = false;
+    int event_base, error_base;
+    Window root = RootWindow(d, screen);
+    XRRScreenResources *resources = XRRQueryExtension(d, &event_base, &error_base)
+        ? XRRGetScreenResourcesCurrent(d, root) : NULL;
+    if (resources != NULL) {
+        RROutput primary = XRRGetOutputPrimary(d, root);
+        for (int i = 0; i < resources->noutput; i++) {
+            RROutput id = resources->outputs[i];
+            XRROutputInfo *output = XRRGetOutputInfo(d, resources, id);
+            if (output == NULL)
+                continue;
+            bool matches = c->output != NULL &&
+                strlen(c->output) == (size_t)output->nameLen &&
+                memcmp(c->output, output->name, output->nameLen) == 0;
+            if (output->connection == RR_Connected && output->crtc != None) {
+                XRRCrtcInfo *crtc = XRRGetCrtcInfo(d, resources, output->crtc);
+                if (crtc != NULL) {
+                    if (crtc->width > 0 && crtc->height > 0 &&
+                        (matches || (!found && (!fallback || id == primary)))) {
+                        ox = crtc->x;
+                        oy = crtc->y;
+                        width = crtc->width;
+                        height = crtc->height;
+                        found = matches;
+                        fallback = true;
+                    }
+                    XRRFreeCrtcInfo(crtc);
+                }
+            }
+            XRRFreeOutputInfo(output);
+        }
+        XRRFreeScreenResources(resources);
+    }
+    if (c->output != NULL && !found) {
+        if (!x->output_warning)
+            LOG_WARN("output '%s' unavailable; using primary/default output", c->output);
+        x->output_warning = true;
+    } else
+        x->output_warning = false;
+
+    int px = c->margins.horizontal;
+    int py = y;
+    switch (c->anchor) {
+    case ANCHOR_TOP_RIGHT: case ANCHOR_BOTTOM_RIGHT:
+        px = width - buf->width - px;
+        break;
+    case ANCHOR_CENTER:
+        px = (width - buf->width) / 2;
+        break;
+    default: break;
+    }
+    if (c->anchor == ANCHOR_BOTTOM_LEFT ||
+        c->anchor == ANCHOR_BOTTOM_RIGHT)
+        py = height - buf->height - py;
+    else if (c->anchor == ANCHOR_CENTER)
+        py = (height - buf->height) / 2 + y;
+    px += ox;
+    py += oy;
+    bool created = window == None;
+    if (created) {
+        XSetWindowAttributes attrs = {
+            .override_redirect = True,
+            .event_mask = ExposureMask | ButtonPressMask,
+        };
+        window = XCreateWindow(d, RootWindow(d, screen), px, py,
+            buf->width, buf->height, 0, CopyFromParent, InputOutput,
+            CopyFromParent, CWOverrideRedirect | CWEventMask, &attrs);
+        XStoreName(d, window, "fnott");
+        Atom type = XInternAtom(d, "_NET_WM_WINDOW_TYPE_NOTIFICATION", False);
+        XChangeProperty(d, window, XInternAtom(d, "_NET_WM_WINDOW_TYPE", False),
+                        XA_ATOM, 32, PropModeReplace, (unsigned char *)&type, 1);
+    }
+    XMoveResizeWindow(d, window, px, py, buf->width, buf->height);
+    if (created)
+        XMapRaised(d, window);
+    XImage *image = XCreateImage(d, DefaultVisual(d, screen),
+        DefaultDepth(d, screen), ZPixmap, 0, buf->mmapped,
+        buf->width, buf->height, 32, buf->stride);
+    if (image != NULL) {
+        GC gc = XCreateGC(d, window, 0, NULL);
+        XPutImage(d, window, gc, image, 0, 0, 0, 0, buf->width, buf->height);
+        XFreeGC(d, gc);
+        image->data = NULL;
+        XDestroyImage(image);
+    }
+    XFlush(d);
+    return window;
+}
+#else
+struct x11 *
+x11_init(const struct config *conf, struct fdm *fdm, struct notif_mgr *mgr)
+{
+    return NULL;
+}
+void x11_destroy(struct x11 *x) {}
+void x11_flush(struct x11 *x) {}
+Window x11_show(struct x11 *x, Window window, struct buffer *buf, int offset)
+{
+    return 0;
+}
+void x11_hide(struct x11 *x, Window window) {}
+#endif
--- /dev/null
+++ b/x11.h
@@ -0,0 +1,18 @@
+#pragma once
+#ifdef FNOTT_ENABLE_X11
+#include <X11/Xlib.h>
+#else
+typedef unsigned long Window;
+#define None 0L
+#endif
+#include "config.h"
+#include "fdm.h"
+#include "shm.h"
+struct notif_mgr;
+struct x11;
+struct x11 *x11_init(const struct config *, struct fdm *, struct notif_mgr *);
+void x11_destroy(struct x11 *);
+void x11_flush(struct x11 *);
+Window x11_show(struct x11 *, Window, struct buffer *, int);
+void x11_hide(struct x11 *, Window);
+void notif_mgr_x11_event(struct notif_mgr *, Window, unsigned int);
