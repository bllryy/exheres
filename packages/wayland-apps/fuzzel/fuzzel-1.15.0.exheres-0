require meson

SUMMARY="Application launcher for wlroots based Wayland compositors"
HOMEPAGE="https://codeberg.org/dnkl/fuzzel"

DOWNLOADS="
    https://codeberg.org/dnkl/fuzzel/releases/download/${PV}/${PNV}.tar.gz
"

LICENCES="MIT"

SLOT="0"

PLATFORMS="~amd64"

MYOPTIONS="
    png [[
        description = [ Build with PNG icon support ]
    ]]

    svg [[
        description = [ Build with SVG icon support ]
    ]]
"

DEPENDENCIES="
    build:
        app-doc/scdoc
        dev-libs/tllist[>=1.0.1]
        sys-libs/wayland-protocols[>=1.41]

    build+run:
        media-libs/fcft[<4.0.0&>=3.3.1]
        media-libs/fontconfig
        sys-libs/wayland
        x11-libs/libxkbcommon
        x11-libs/pixman:1[>=0.46.0]

        png? (
            media-libs/libpng
        )

        svg? (
            media-libs/nanosvg
        )
"

src_configure() {
    meson_src_configure \
        -Denable-cairo=disabled \
        -Dpng-backend="$(option png libpng none)" \
        -Dsvg-backend="$(option svg nanosvg none)" \
        -Dsystem-nanosvg="$(option svg enabled disabled)"
}

src_install() {
    meson_src_install
    edo rm -rf "${IMAGE}/usr/share/doc/fuzzel"
}

pkg_postinst() {
    einfo "An example configuration file is installed at"
    einfo "/etc/xdg/fuzzel/fuzzel.ini"
    einfo "Copy it to ~/.config/fuzzel/ and edit it as needed."
}
