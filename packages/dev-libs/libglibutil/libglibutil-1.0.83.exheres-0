SUMMARY="GLib utility library for Binder components"
HOMEPAGE="https://github.com/sailfishos/libglibutil"
DOWNLOADS="${HOMEPAGE}/archive/refs/tags/${PV}.tar.gz -> ${PNV}.tar.gz"

LICENCES="BSD-3"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        dev-util/pkgconf

    build+run:
        dev-libs/glib:2
"

src_prepare() {
    default
    edo sed -i "s@/usr/include@/usr/$(exhost --target)/include@g" \
        Makefile libglibutil.pc.in
}

src_compile() {
    emake release pkgconfig KEEP_SYMBOLS=1 CC="${CC}" AR="${AR}" \
        LIBDIR="usr/$(exhost --target)/lib"
}

src_install() {
    emake install-dev DESTDIR="${IMAGE}" LIBDIR="usr/$(exhost --target)/lib"
    emagicdocs
}
