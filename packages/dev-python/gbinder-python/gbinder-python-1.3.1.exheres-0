require py-pep517 [ backend=setuptools blacklist="3.9 3.10 3.11" ]

SUMMARY="Python bindings for libgbinder"
HOMEPAGE="https://github.com/waydroid/gbinder-python"
DOWNLOADS="${HOMEPAGE}/archive/refs/tags/${PV}.tar.gz -> ${PNV}.tar.gz"

LICENCES="GPL-3"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        dev-python/Cython[python_abis:*(-)?]
        dev-util/pkgconf

    build+run:
        dev-libs/libgbinder[>=1.1.40]
"

prepare_one_multibuild() {
    py-pep517_prepare_one_multibuild
    edo sed -i "s@pkg-config --cflags@${PKG_CONFIG} --cflags@" setup.py
}
