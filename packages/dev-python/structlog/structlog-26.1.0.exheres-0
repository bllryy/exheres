require pypi py-pep517 [ backend=hatchling blacklist="3.9" ]

SUMMARY="Structured logging for Python"

LICENCES="|| ( Apache-2.0 MIT )"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        dev-python/hatch_vcs[python_abis:*(-)?]
        dev-python/hatch-fancy-pypi-readme[>=22.8.0][python_abis:*(-)?]

    run:
        python_abis:3.10? ( dev-python/typing-extensions[python_abis:3.10] )
"
