require freedesktop-desktop freedesktop-mime gtk-icon-cache

SUMMARY="Video conferencing client"
HOMEPAGE="https://www.zoom.com/"
DOWNLOADS="https://zoom.us/client/${PV}/zoom_x86_64.tar.xz -> ${PNV}.tar.xz"

LICENCES="all-rights-reserved"
SLOT="0"
PLATFORMS="~amd64"
RESTRICT="mirror strip test"

DEPENDENCIES="
    run:
        app-arch/zstd
        app-crypt/krb5
        dev-libs/at-spi2-core
        dev-libs/expat
        dev-libs/glib:2
        dev-libs/libglvnd
        dev-libs/nspr
        dev-libs/nss
        media-libs/fontconfig
        media-libs/freetype
        media-sound/pulseaudio
        net-print/cups
        sys-apps/dbus
        sys-apps/util-linux
        sys-libs/libatomic
        sys-libs/wayland
        sys-libs/zlib
        sys-sound/alsa-lib
        x11-dri/libdrm
        x11-dri/mesa
        x11-libs/cairo
        x11-libs/libX11
        x11-libs/libXcomposite
        x11-libs/libXdamage
        x11-libs/libXext
        x11-libs/libXfixes
        x11-libs/libXrandr
        x11-libs/libXtst
        x11-libs/libxcb
        x11-libs/libxkbcommon
        x11-libs/pango
        x11-utils/xcb-util
        x11-utils/xcb-util-cursor
        x11-utils/xcb-util-image
        x11-utils/xcb-util-keysyms
        x11-utils/xcb-util-renderutil
        x11-utils/xcb-util-wm
"

WORK="${WORKBASE}/zoom"

pkg_setup() {
    exdirectory --allow /opt
}

src_install() {
    edo mkdir -p "${IMAGE}/opt/zoom"
    edo cp -a "${WORK}/." "${IMAGE}/opt/zoom/"
    edo find "${IMAGE}/opt/zoom" -depth -type d -empty -delete

    insinto /usr/share/applications
    doins "${FILES}/zoom.desktop"
    insinto /usr/share/icons/hicolor/scalable/apps
    newins "${FILES}/zoom.svg" zoom.svg

    dodir /usr/$(exhost --target)/bin
    dosym /opt/zoom/ZoomLauncher /usr/$(exhost --target)/bin/zoom
}

pkg_postinst() {
    freedesktop-mime_pkg_postinst
    freedesktop-desktop_pkg_postinst
    gtk-icon-cache_pkg_postinst
}

pkg_postrm() {
    freedesktop-mime_pkg_postrm
    freedesktop-desktop_pkg_postrm
    gtk-icon-cache_pkg_postrm
}
