require freedesktop-desktop freedesktop-mime gtk-icon-cache

SUMMARY="Desktop messenger for text, voice, and video calls"
HOMEPAGE="https://www.viber.com/en/"
DOWNLOADS="https://download.cdn.viber.com/cdn/desktop/Linux/viber.deb -> ${PNV}.deb"

LICENCES="all-rights-reserved"
SLOT="0"
PLATFORMS="~amd64"
RESTRICT="mirror strip test"

DEPENDENCIES="
    run:
        app-arch/brotli
        app-arch/bzip2
        app-arch/snappy
        app-arch/zstd
        app-crypt/krb5
        app-crypt/libb2
        dev-libs/double-conversion
        dev-libs/expat
        dev-libs/glib:2
        dev-libs/gnutls
        dev-libs/libglvnd
        dev-libs/libxml2:2.0
        dev-libs/libxslt
        dev-libs/nspr
        dev-libs/nss
        dev-libs/openssl:3
        media-libs/fontconfig
        media-libs/freetype
        media-libs/OpenJPEG:2
        media-libs/libpng
        media-libs/libvorbis
        media-libs/opus
        media-sound/pulseaudio
        net-libs/libssh
        sys-apps/dbus
        sys-libs/libgomp
        sys-libs/libinput
        sys-libs/zlib
        sys-libs/wayland
        sys-sound/alsa-lib
        x11-dri/libdrm
        x11-dri/mesa
        x11-libs/libICE
        x11-libs/libSM
        x11-libs/libX11
        x11-libs/libXext
        x11-libs/libXfixes
        x11-libs/libXi
        x11-libs/libXrandr
        x11-libs/libXrender
        x11-libs/libXScrnSaver
        x11-libs/libXtst
        x11-libs/libxcb
        x11-libs/libxkbcommon
        x11-libs/libxkbfile
        x11-libs/libva
        x11-libs/libvdpau
        x11-libs/libxshmfence
        x11-libs/mtdev
        x11-utils/xcb-util
        x11-utils/xcb-util-cursor
        x11-utils/xcb-util-image
        x11-utils/xcb-util-keysyms
        x11-utils/xcb-util-renderutil
        x11-utils/xcb-util-wm
"

WORK="${WORKBASE}"

pkg_setup() {
    exdirectory --allow /opt
}

src_unpack() {
    local checksum
    checksum=$(sha256sum "${FETCHEDDIR}/${PNV}.deb") || die "Cannot checksum Viber archive"
    [[ ${checksum%% *} == 961534dc0cb920006ec7ae8108b0e1ba09a476eef1e13b4b370a79cd52dd20f3 ]] ||
        die "Viber archive changed; check version before updating checksum"

    default
    unpack ./data.tar.xz
}

src_install() {
    edo mkdir -p "${IMAGE}/opt/viber"
    edo cp -a opt/viber/. "${IMAGE}/opt/viber/"

    insinto /usr/share/applications
    doins usr/share/applications/viber.desktop

    insinto /usr/share/pixmaps
    doins usr/share/pixmaps/viber.png
    insinto /usr/share/icons/hicolor/scalable/apps
    newins usr/share/icons/hicolor/scalable/apps/Viber.svg viber.svg

    local size
    for size in 16 24 32 48 64 96 128 256; do
        insinto /usr/share/icons/hicolor/${size}x${size}/apps
        newins "usr/share/viber/${size}x${size}.png" viber.png
    done

    dodir /usr/$(exhost --target)/bin
    dosym /opt/viber/Viber /usr/$(exhost --target)/bin/viber
}

pkg_postinst() {
    freedesktop-mime_pkg_postinst
    freedesktop-desktop_pkg_postinst
    gtk-icon-cache_pkg_postinst
}

pkg_postrm() {
    freedesktop-mime_pkg_postrm
    freedesktop-desktop_pkg_postrm
    gtk-icon-cache_pkg_postrm
}
