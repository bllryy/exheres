require freedesktop-desktop gtk-icon-cache

SUMMARY="Custom Discord desktop app with Vencord preinstalled"
HOMEPAGE="https://github.com/Vencord/Vesktop"
DOWNLOADS="${HOMEPAGE}/releases/download/v${PV}/${PN}_${PV}_amd64.deb"

LICENCES="GPL-3"
SLOT="0"
PLATFORMS="~amd64"
RESTRICT="mirror strip test"

DEPENDENCIES="
    run:
        dev-libs/at-spi2-core
        dev-libs/expat
        dev-libs/glib:2
        dev-libs/libsecret
        dev-libs/nspr
        dev-libs/nss
        media-libs/fontconfig
        media-libs/freetype
        net-print/cups
        sys-apps/dbus
        sys-apps/util-linux
        sys-sound/alsa-lib
        x11-apps/xdg-utils
        x11-dri/libdrm
        x11-dri/mesa
        x11-libs/cairo
        x11-libs/gdk-pixbuf:2.0
        x11-libs/gtk+:3
        x11-libs/libnotify
        x11-libs/libX11
        x11-libs/libXcomposite
        x11-libs/libXdamage
        x11-libs/libXext
        x11-libs/libXfixes
        x11-libs/libXrandr
        x11-libs/libXtst
        x11-libs/libxcb
        x11-libs/libxkbcommon
        x11-libs/pango
"

WORK="${WORKBASE}"

pkg_setup() {
    exdirectory --allow /opt
}

src_unpack() {
    default
    unpack ./data.tar.xz
}

src_install() {
    edo mkdir -p "${IMAGE}/opt/Vesktop"
    edo cp -r opt/Vesktop/. "${IMAGE}/opt/Vesktop/"

    dodir /usr/$(exhost --target)/bin
    dosym ../../../opt/Vesktop/vesktop /usr/$(exhost --target)/bin/${PN}

    insinto /usr/share/applications
    doins usr/share/applications/vesktop.desktop

    insinto /usr/share/icons/hicolor/scalable/apps
    doins usr/share/icons/hicolor/scalable/apps/vesktop.svg
}

pkg_postinst() {
    freedesktop-desktop_pkg_postinst
    gtk-icon-cache_pkg_postinst
}

pkg_postrm() {
    freedesktop-desktop_pkg_postrm
    gtk-icon-cache_pkg_postrm
}
