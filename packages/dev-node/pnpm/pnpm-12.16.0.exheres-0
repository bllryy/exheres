SUMMARY="Fast, disk space efficient package manager"
HOMEPAGE="https://pnpm.io"
DOWNLOADS="https://github.com/pnpm/pnpm/releases/download/v${PV}/pnpm-linux-x64.tar.gz -> ${PNV}.tar.gz"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"
RESTRICT="mirror strip test"

WORK="${WORKBASE}/${PNV}"

src_unpack() {
    local checksum
    checksum=$(sha256sum "${FETCHEDDIR}/${PNV}.tar.gz") || die "Cannot checksum pnpm archive"
    [[ ${checksum%% *} == 4492070f381f5cc42b977b968d8d72b970ffd17bef2523c229170b2cd4ece44a ]] ||
        die "pnpm archive changed; check version before updating checksum"
    edo mkdir -p "${WORK}"
    edo tar xzf "${FETCHEDDIR}/${PNV}.tar.gz" --no-same-owner -C "${WORK}"
}

src_compile() {
    :
}

src_install() {
    local prefix=/usr/$(exhost --target)
    edo mkdir -p "${IMAGE}${prefix}/lib/${PNV}"
    edo cp -a "${WORK}/." "${IMAGE}${prefix}/lib/${PNV}/"
    edo find "${IMAGE}${prefix}/lib/${PNV}" -depth -type d -empty -delete
    edo mkdir -p "${IMAGE}${prefix}/bin"
    dosym "../lib/${PNV}/pnpm" "${prefix}/bin/pnpm"
    printf '#!/bin/sh\nexec "$(dirname "$0")/pnpm" dlx "$@"\n' > "${WORKBASE}/pnpx" || die
    exeinto "${prefix}/bin"
    newexe "${WORKBASE}/pnpx" pnpx
}
