SUMMARY="Chromium-based application runtime (official binary, version 44)"
HOMEPAGE="https://www.electronjs.org/"
DOWNLOADS="https://github.com/electron/electron/releases/download/v${PV}/electron-v${PV}-linux-x64.zip -> ${PNV}.zip"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"
RESTRICT="mirror strip test"

DEPENDENCIES="
    build:
        app-arch/unzip

    run:
        dev-libs/at-spi2-core
        dev-libs/expat
        dev-libs/glib:2
        dev-libs/nspr
        dev-libs/nss
        media-libs/fontconfig
        net-print/cups
        sys-apps/dbus
        sys-sound/alsa-lib
        x11-dri/libdrm
        x11-dri/mesa
        x11-libs/gtk+:3
        x11-libs/libX11
        x11-libs/libXcomposite
        x11-libs/libXdamage
        x11-libs/libXext
        x11-libs/libXfixes
        x11-libs/libXrandr
        x11-libs/libxcb
        x11-libs/libxkbcommon
"

WORK="${WORKBASE}/electron44"

pkg_setup() {
    exdirectory --allow /opt
}

src_unpack() {
    edo mkdir -p "${WORK}"
    edo unzip -q "${FETCHEDDIR}/${PNV}.zip" -d "${WORK}"
}

src_compile() {
    :
}

src_install() {
    edo mkdir -p "${IMAGE}/opt/electron44"
    edo cp -a "${WORK}/." "${IMAGE}/opt/electron44/"
    edo chmod 4755 "${IMAGE}/opt/electron44/chrome-sandbox"
    exeinto /usr/$(exhost --target)/bin
    newexe "${FILES}/electron44-launcher" electron44
}
