require meson [ meson_minimum_version=0.57.0 ] systemd-service

SUMMARY="Toolkit for managing virtualization hosts and guests"
HOMEPAGE="https://libvirt.org/"
DOWNLOADS="https://libvirt.org/sources/${PNV}.tar.xz"

LICENCES="LGPL-2.1+"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS="
    network [[ description = [ Enable virtual networks using dnsmasq and nftables ] ]]
    polkit
    qemu [[ description = [ Enable the QEMU/KVM driver ] ]]
    systemd
    providers: eudev systemd [[ number-selected = exactly-one ]]
"

DEPENDENCIES="
    build:
        dev-lang/perl
        dev-lang/python:=[>=3.9]
        dev-libs/libxslt
        sys-devel/gettext
        virtual/pkg-config
        dev-python/docutils
    build+run:
        dev-libs/glib:2[>=2.68]
        dev-libs/json-c[>=0.14]
        dev-libs/libbsd
        dev-libs/libxml2[>=2.9.1]
        dev-libs/gnutls[>=3.6.0]
        net-libs/libnl:3.0[>=3.0]
        net-libs/libssh2[>=1.3]
        net-libs/libtirpc
        sys-apps/acl
        sys-apps/attr
        sys-apps/util-linux[>=2.17]
        sys-fs/lvm2
        sys-libs/libcap-ng[>=0.7]
        sys-libs/readline:=[>=7.0]
        providers:eudev? ( sys-apps/eudev )
        providers:systemd? ( sys-apps/systemd[>=219] )
        x11-libs/libpciaccess[>=0.10.9]
        polkit? ( sys-auth/polkit[>=0.112] )
        systemd? ( sys-apps/systemd[>=185] )
    run:
        group/libvirt
        network? (
            net-dns/dnsmasq
            net-firewall/nftables
            sys-apps/iproute2
        )
        qemu? (
            app-virtualization/qemu
            group/qemu
            user/qemu
        )
"

MESON_SRC_CONFIGURE_PARAMS=(
    -Dauto_features=disabled
    -Dsystem=true
    # Also installs API XML required to build libvirt-python.
    -Ddocs=enabled
    -Drunstatedir=/run
    -Dunitdir="${SYSTEMDSYSTEMUNITDIR}"
    -Dsysusersdir=/usr/lib/sysusers.d
    -Dremote_default_mode=legacy
    -Ddriver_remote=enabled
    -Ddriver_libvirtd=enabled
    -Dlibvirtd=enabled
    -Ddriver_test=enabled
    -Ddriver_interface=disabled
    -Ddriver_secrets=enabled
    -Dstorage_dir=enabled
    -Dstorage_disk=disabled
    -Dstorage_fs=disabled
    -Dstorage_lvm=disabled
    -Dstorage_mpath=disabled
    -Dstorage_scsi=disabled
    -Dattr=enabled
    -Dblkid=enabled
    -Dcapng=enabled
    -Djson_c=enabled
    -Dlibnl=enabled
    -Dlibssh2=enabled
    -Dpciaccess=enabled
    -Dreadline=enabled
    -Dudev=enabled
    -Dhost_validate=enabled
    -Dtests=enabled
    -Dexpensive_tests=disabled
    -Dqemu_user=qemu
    -Dqemu_group=qemu
    -Dfirewall_backend_priority=nftables
)
MESON_SRC_CONFIGURE_OPTIONS=(
    'network driver_network'
    polkit
    'qemu driver_qemu'
)

src_configure() {
    meson_src_configure -Dinit_script="$(option systemd systemd none)"
}

src_install() {
    meson_src_install

    # Exherbo account packages own account creation, including on non-systemd hosts.
    if option qemu; then
        edo rm "${IMAGE}"/usr/lib/sysusers.d/libvirt-qemu.conf
    fi
}
