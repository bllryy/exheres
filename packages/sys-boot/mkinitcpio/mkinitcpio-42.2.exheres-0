MESON_SOURCE="${WORKBASE}/${PN}-v${PV}"

require meson

SUMMARY="Bash script for creating initramfs images"
HOMEPAGE="https://gitlab.archlinux.org/archlinux/mkinitcpio/mkinitcpio"
DOWNLOADS="${HOMEPAGE}/-/archive/v${PV}/${PN}-v${PV}.tar.bz2"

LICENCES="GPL-2"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS="
    crypt [[ description = [ Support encrypted devices using cryptsetup ] ]]
    uki [[ description = [ Enable UKI creation using systemd ukify and EFI stub ] ]]
"

DEPENDENCIES="
    build:
        sys-devel/meson[>=1.4.0]
    build+run:
        sys-apps/systemd
    run:
        app-arch/cpio
        app-arch/gzip
        app-arch/libarchive
        app-arch/zstd
        app-shells/bash[>=4.4]
        sys-apps/busybox
        sys-apps/coreutils
        sys-apps/diffutils
        sys-apps/findutils
        sys-apps/gawk
        sys-apps/grep
        sys-apps/kbd
        sys-apps/kmod
        sys-apps/util-linux
        sys-devel/binutils
        sys-devel/gcc
        sys-libs/glibc
        crypt? ( sys-fs/cryptsetup )
        uki? ( sys-apps/systemd[uki] )
"

MESON_SRC_CONFIGURE_PARAMS=(
    -Ddocs=false
    -Dalpm=false
    -Dkernel_install=false
    -Dpresets=false
    -Dsystemd=disabled
    -Dsystemd_hooks=false
)

src_prepare() {
    meson_src_prepare
    edo meson rewrite kwargs set project / version "${PV}"
    local host=$(exhost --target)

    edo sed -i \
        -e "s|@BINDIR@:/bin|@BINDIR@:/usr/${host}/bin:/usr/bin:/bin|" mkinitcpio
    edo sed -i "s|/usr/lib/initcpio/busybox|/usr/${host}/bin/busybox|g" install/base
    edo sed -i "s|/usr/lib/initcpio|/usr/${host}/lib/initcpio|g" \
        mkinitcpio functions init shutdown install/* hooks/*
    edo sed -i \
        -e "s|udevdir = '/usr/lib/udev'|udevdir = libdir / 'udev'|" \
        -e "s|tmpfilesdir = '/usr/lib/tmpfiles.d'|tmpfilesdir = libdir / 'tmpfiles.d'|" meson.build
    edo sed -i \
        -e "s|'/usr/bin/udevadm'|'udevadm'|" \
        -e "s|/usr/lib/udev/|/usr/${host}/lib/udev/|g" \
        -e "s|/usr/lib/libkmod.so.2|/usr/${host}/lib/libkmod.so.2|" install/udev
    edo sed -i \
        -e "s|/usr/lib/libgcc_s.so.1|/usr/${host}/lib/libgcc_s.so.1|" \
        -e "s#    add_binary '/usr/lib/ossl-modules/legacy.so'#    for mod in /usr/${host}/lib/{ossl-modules,openssl-*/lib/ossl-modules}/legacy.so; do [[ ! -f \"\$mod\" ]] || add_binary \"\$mod\"; done#" install/encrypt
    edo sed -i \
        -e "s|PATH='/usr/lib/udev/rules.d:/lib/udev/rules.d'|PATH='/usr/${host}/lib/udev/rules.d:/usr/lib/udev/rules.d:/lib/udev/rules.d'|" \
        -e "s|PATH='/usr/lib/udev:/lib/udev'|PATH='/usr/${host}/lib/udev:/usr/lib/udev:/lib/udev'|" \
        -e "s|add_file \"\$rules\" /usr/lib/udev/rules.d/|add_file \"\$rules\" /usr/${host}/lib/udev/rules.d/|" \
        -e '/dest="${2:-$binary}"/a\    [[ "$1" == /* || -n "$2" ]] || dest="/usr/bin/${1##*/}"' \
        functions
    edo sed -i \
        "s|hooks = 'base udev .*'|hooks = 'base udev modconf keyboard keymap block filesystems'|" meson.build
}

src_install() {
    meson_src_install
    insinto /usr/share/doc/${PNVR}/examples
    doins "${IMAGE}/etc/mkinitcpio.conf"
    edo rm "${IMAGE}/etc/mkinitcpio.conf"

    keepdir /etc/initcpio/{hooks,install,post} /etc/mkinitcpio{.conf.d,.d} \
        /usr/$(exhost --target)/lib/initcpio/post
}
