SUMMARY="Mullvad VPN desktop client and daemon"
HOMEPAGE="https://mullvad.net/"

DOWNLOADS="
    https://repository.mullvad.net/rpm/stable/mullvad-vpn-${PV}.x86_64.rpm
        -> ${PNV}.rpm
"

LICENCES="GPL-3"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        app-arch/rpm2targz

    run:
        dev-libs/at-spi2-core
        sys-sound/alsa-lib
        x11-dri/mesa
        x11-dri/libdrm
        sys-apps/dbus
"

pkg_setup() {
    exdirectory --allow /opt
}

src_unpack() {
    edo mkdir -p "${WORK}"

    edo rpm2targz "${FETCHEDDIR}/${PNV}.rpm"
    edo tar -xzf "${WORKBASE}/${PNV}.tar.gz" -C "${WORK}"
}

src_install() {
    edo cp -rT "${WORK}" "${IMAGE}"

    edo mkdir -p "${IMAGE}/usr/${CHOST}"
    edo mv "${IMAGE}/usr/bin" "${IMAGE}/usr/${CHOST}/"

    if [[ -d "${IMAGE}/usr/lib" ]]; then
        edo mv "${IMAGE}/usr/lib" "${IMAGE}/usr/${CHOST}/"
    fi
}
