SUMMARY="GTK3 settings editor adapted to work in wlroots-based compositors"
HOMEPAGE="https://github.com/nwg-piotr/nwg-look"

DOWNLOADS="
    https://github.com/nwg-piotr/nwg-look/archive/refs/tags/v${PV}.tar.gz
        -> ${PNV}.tar.gz
"

LICENCES="MIT"
SLOT="0"
PLATFORMS="~amd64"

DEPENDENCIES="
    build:
        dev-lang/go[>=1.26]

    build+run:
        dev-libs/glib
        media-libs/fontconfig
        media-libs/freetype
        x11-libs/harfbuzz
        x11-misc/xcur2png
        x11-libs/cairo
        x11-libs/gdk-pixbuf
        x11-libs/gtk+:3
        x11-libs/pango
"

src_prepare() {
    default

    export GOMODCACHE="${WORKBASE}/gomodcache"
    export GOCACHE="${WORKBASE}/gocache"

    esandbox disable_net
    edo go mod download
    esandbox enable_net
}

src_compile() {
    export GOMODCACHE="${WORKBASE}/gomodcache"
    export GOCACHE="${WORKBASE}/gocache"

    emake build
}

src_install() {
    insinto /usr/share/nwg-look
    doins stuff/main.glade
    doins -r langs

    insinto /usr/share/pixmaps
    doins stuff/nwg-look.svg

    insinto /usr/share/applications
    doins stuff/nwg-look.desktop

    dobin bin/nwg-look

    docinto nwg-look
    dodoc README.md
    dodoc LICENSE
}
