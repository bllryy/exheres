require alternatives flag-o-matic

SUMMARY="Service supervision and init system"
HOMEPAGE="https://github.com/davmac314/dinit"
ZRAM_COMMIT=2bd6ce8827446c6b1d6b801ac34db1c6c7981f54
DOWNLOADS="
    ${HOMEPAGE}/releases/download/v${PV}/${PNV}.tar.xz
    zram? ( https://github.com/chimera-linux/dinit-chimera/archive/${ZRAM_COMMIT}.tar.gz -> dinit-chimera-${ZRAM_COMMIT}.tar.gz )
"

LICENCES="Apache-2.0 BSD-2"
SLOT="0"
PLATFORMS="~amd64"
MYOPTIONS="
    caps [[ description = [ Enable Linux capabilities support ] ]]
    cgroups [[ description = [ Enable Linux control groups support ] ]]
    sysv-utils [[ description = [ Install init symlink and shutdown utilities ] ]]
    zram [[ description = [ Build and install Chimera's zram device setup helper ] ]]
"

DEPENDENCIES="
    build:
        dev-util/pkgconf
        sys-devel/m4
    build+run:
        caps? ( sys-libs/libcap )
    run:
        zram? (
            sys-apps/kmod
            sys-apps/util-linux
        )
"

DEFAULT_SRC_PREPARE_PATCHES=(
    "${FILES}"/${PN}-0.22.1-soft-reboot-signal-mask.patch
)

src_configure() {
    export CXX_FOR_BUILD="$(exhost --build)-c++"
    export CXXFLAGS_FOR_BUILD="-std=c++11 $(print-build-flags CXXFLAGS)"
    export CPPFLAGS_FOR_BUILD="$(print-build-flags CPPFLAGS) "
    export LDFLAGS_FOR_BUILD="$(print-build-flags LDFLAGS) "

    export CXXFLAGS_EXTRA="${CXXFLAGS}" LDFLAGS_EXTRA="${LDFLAGS}"
    unset CXXFLAGS LDFLAGS

    edo ./configure \
        --platform=Linux \
        --prefix=/usr \
        --bindir=/usr/$(exhost --target)/bin \
        --sbindir=/usr/$(exhost --target)/bin \
        --mandir=/usr/share/man \
        --syscontrolsocket=/run/dinitctl \
        --shutdown-prefix= \
        --disable-strip \
        $(option_enable caps capabilities) \
        $(option_enable cgroups) \
        $(option_enable sysv-utils shutdown)
}

src_compile() {
    default

    if option zram; then
        edo $(exhost --target)-c++ $(print-build-flags CPPFLAGS) $(print-build-flags CXXFLAGS) \
            -std=c++17 -include cmath -include cctype -include cstdlib -include clocale \
            "${WORKBASE}/dinit-chimera-${ZRAM_COMMIT}/early/helpers/zram.cc" \
            $(print-build-flags LDFLAGS) -o zram
    fi
}

src_install() {
    default

    if option zram; then
        exeinto /usr/$(exhost --target)/libexec/dinit-chimera
        doexe zram
        insinto /usr/share/doc/${PNVR}
        doins "${WORKBASE}/dinit-chimera-${ZRAM_COMMIT}/early/helpers/zram.cc"
    fi

    if option sysv-utils; then
        local tool host=$(exhost --target) alternatives=( init ${PN} 5 )
        dosym dinit /usr/${host}/bin/init
        alternatives+=( /usr/${host}/bin/init ${PN}.init )
        alternatives+=( /usr/share/man/man8/init.8 ${PN}.init.8 )
        dosym dinit.8 /usr/share/man/man8/init.8
        for tool in shutdown halt reboot poweroff soft-reboot; do
            alternatives+=(
                /usr/${host}/bin/${tool} ${PN}.${tool}
                /usr/share/man/man8/${tool}.8 ${PN}.${tool}.8
            )
        done
        alternatives_for "${alternatives[@]}"
        for tool in halt reboot poweroff soft-reboot; do
            edo ln -sf ${PN}.shutdown "${IMAGE}"/usr/${host}/bin/${PN}.${tool}
            edo ln -sf ${PN}.shutdown.8 "${IMAGE}"/usr/share/man/man8/${PN}.${tool}.8
        done
    fi
}
