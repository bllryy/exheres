#!/bin/sh
# mkinitcpio 42.2 requests exit but does not wait before switch_root.
# Do not signal processes or trust a stale PID file/socket.
set -eu
PATH=/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin
export PATH
[ "$#" -eq 0 ] || { printf '%s\n' 'console-udev-stopped: no arguments accepted' >&2; exit 1; }
exec timeout --signal=KILL 30 sh -c '
    while :; do
        busy=false
        for file in /proc/[0-9]*/comm; do
            if ! IFS= read -r name < "$file"; then
                [ ! -e "$file" ] && continue
                printf "%s\n" "console-udev-stopped: cannot inspect $file" >&2
                exit 1
            fi
            case "$name" in
                udevd|systemd-udevd|udev-worker|\(udev-worker\)) busy=true ;;
            esac
        done
        [ "$busy" = true ] || exit 0
        sleep 0.2
    done
'
