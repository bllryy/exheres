#!/bin/sh
set -eu
PATH=/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin
export PATH
[ "$#" -eq 0 ] || exit 2
attempt=0
while [ "$attempt" -lt 10 ]; do
    if dbus-send --bus=unix:path=/run/dbus/system_bus_socket \
        --dest=org.freedesktop.DBus --type=method_call --print-reply \
        --reply-timeout=1000 /org/freedesktop/DBus \
        org.freedesktop.DBus.ListNames >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done
printf '%s\n' 'console-dbus-ready: system bus did not answer ListNames' >&2
exit 1
