#!/usr/bin/env python3
"""Prepare persistent XFS scrub stamp directory, without following symlinks."""
import os
import stat
import sys

DIRECTORY = '/var/lib/xfsprogs'


def main():
    try:
        os.mkdir(DIRECTORY, 0o755)
    except FileExistsError:
        pass
    info = os.lstat(DIRECTORY)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or info.st_mode & 0o022:
        raise RuntimeError('unsafe /var/lib/xfsprogs: need root:root directory without group/other write access')


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(str(error))
