#!/usr/bin/python3
"""Wait for PipeWire to answer a connection probe."""
import os
import subprocess
import sys

os.environ.update(PIPEWIRE_REMOTE='pipewire-0', PIPEWIRE_CONFIG_DIR='/usr/share/pipewire',
                  PIPEWIRE_CONFIG_NAME='client.conf')
for attempt in range(50):
    try:
        status = subprocess.run([
            '/usr/x86_64-pc-linux-gnu/bin/timeout', '1',
            '/usr/x86_64-pc-linux-gnu/bin/pw-cli', 'info', '0',
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    except OSError:
        status = 1
    if status == 0:
        sys.exit(0)
    result = subprocess.run(['/usr/x86_64-pc-linux-gnu/bin/sleep', '0.1'])
    if result.returncode:
        sys.exit(result.returncode if result.returncode > 0 else 128 - result.returncode)
sys.exit(1)
