#!/usr/bin/env python3
"""Optional zram0 swap using installed zram-generator configuration, not systemd units."""
import pathlib
import subprocess
import sys

BIN = '/usr/x86_64-pc-linux-gnu/bin/'
GENERATOR = '/usr/x86_64-pc-linux-gnu/lib/systemd/system-generators/zram-generator'


def run(*args):
    subprocess.run(args, check=True)


def main(action):
    if action == 'start':
        # Never reset/reformat an already configured device owned by another manager.
        size = pathlib.Path('/sys/block/zram0/disksize')
        if size.exists() and int(size.read_text()) != 0:
            raise RuntimeError('zram0 already configured; refusing to take ownership')
        run(BIN + 'modprobe', 'zram')
        try:
            run(GENERATOR, '--setup-device', 'zram0')
            run(BIN + 'swapon', '/dev/zram0')
        except (OSError, subprocess.CalledProcessError):
            run(GENERATOR, '--reset-device', 'zram0')
            raise
    elif action == 'stop':
        # A failed swapoff (including insufficient RAM) must never reset live swap.
        run(BIN + 'swapoff', '/dev/zram0')
        run(GENERATOR, '--reset-device', 'zram0')
    else:
        raise ValueError('expected start or stop')


if __name__ == '__main__':
    try:
        main(sys.argv[1] if len(sys.argv) == 2 else '')
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
