#!/usr/bin/python3
"""Manage graphical session environment and activation readiness."""
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys

NAMES = 'DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XAUTHORITY'.split()


def run(*args):
    try:
        return subprocess.run(args).returncode == 0
    except OSError:
        return False


def cleanup(state):
    result = 0
    try:
        (state / 'active').unlink(missing_ok=True)
    except OSError:
        result = 1
    commands = [
        ['dinitctl', '--user', 'stop', 'graphical.monitor'],
        ['dinitctl', '--user', 'unsetenv', *NAMES],
        ['dinitctl', '--user', 'untrigger', 'graphical.target'],
        ['dinitctl', '--user', 'stop', 'graphical.target'],
        ['dbus-update-activation-environment', *[name + '=' for name in NAMES]],
    ]
    for command in commands:
        if not run(*command):
            result = 1
    return result


def main(args):
    env = os.environ
    manager = env.get('SWAY_SESSION_MANAGER')
    if manager not in ('dinit', 'systemd'):
        print('graphical-env: SWAY_SESSION_MANAGER must be dinit or systemd', file=sys.stderr)
        return 2
    if manager == 'systemd':
        if len(args) != 1 or args[0] not in ('import', 'cleanup'):
            return 2
        names = ['DISPLAY', 'WAYLAND_DISPLAY', 'SWAYSOCK', 'XAUTHORITY',
                 'XDG_CURRENT_DESKTOP', 'XDG_SESSION_DESKTOP', 'XDG_SESSION_TYPE']
        if args[0] == 'cleanup':
            result = not run('systemctl', '--user', 'unset-environment', *names)
            result = not run('dbus-update-activation-environment', *[n + '=' for n in names]) or result
            return int(result)
        if not env.get('WAYLAND_DISPLAY') or not env.get('SWAYSOCK'):
            return 1
        values = {n: env.get(n, '') for n in names}
        values.update(XDG_CURRENT_DESKTOP=env.get('XDG_CURRENT_DESKTOP') or 'sway',
                      XDG_SESSION_DESKTOP=env.get('XDG_SESSION_DESKTOP') or 'sway',
                      XDG_SESSION_TYPE='wayland')
        command = ['dbus-update-activation-environment', '--systemd',
                   *[n + '=' + values[n] for n in names]]
        os.execvp(command[0], command)
    state_value = env.get('SWAY_SESSION_STATE', '')
    if not state_value or not Path(state_value).is_dir():
        return 2
    state = Path(state_value)
    with (state / 'lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if len(args) != 1 or args[0] not in ('import', 'cleanup'):
            print('usage: graphical-env import|cleanup', file=sys.stderr)
            return 2
        if args[0] == 'cleanup':
            return cleanup(state)
        if not (state / 'active').is_file():
            return 1
        if not all(env.get(n) for n in ('WAYLAND_DISPLAY', 'SWAYSOCK', 'DBUS_SESSION_BUS_ADDRESS')):
            print('graphical-env: import requires running Sway and user D-Bus', file=sys.stderr)
            return 1
        if not all(shutil.which(n) for n in ('dinitctl', 'dbus-update-activation-environment')):
            return 1
        env.update(XDG_CURRENT_DESKTOP=env.get('XDG_CURRENT_DESKTOP') or 'sway',
                   XDG_SESSION_DESKTOP=env.get('XDG_SESSION_DESKTOP') or 'sway',
                   XDG_SESSION_TYPE='wayland')
        values = [n + '=' + env.get(n, '') for n in
                  ('SWAYSOCK', 'XDG_CURRENT_DESKTOP', 'XDG_SESSION_DESKTOP', 'XDG_SESSION_TYPE', 'XAUTHORITY')]
        displays = [n + '=' + env.get(n, '') for n in ('DISPLAY', 'WAYLAND_DISPLAY')]
        commands = [
            ['dbus-update-activation-environment', *values, *displays],
            ['dinitctl', '--user', 'setenv', *values],
            ['dinitctl', '--user', 'setenv', *displays],
            ['dinitctl', '--user', 'start', 'graphical.monitor'],
            ['dinitctl', '--user', 'trigger', 'graphical.target'],
            ['dinitctl', '--user', 'start', 'graphical.target'],
        ]
        for command in commands:
            if not run(*command):
                cleanup(state)
                return 1
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as error:
        print(error, file=sys.stderr)
        sys.exit(1)
