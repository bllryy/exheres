#!/usr/bin/python3 -I
"""Start supervised system bus, allowing a stale socket after soft reboot."""
import errno
import os
from pathlib import Path
import socket
import stat
import sys


def check_socket(directory=Path('/run/dbus')):
    try:
        info = directory.lstat()
    except FileNotFoundError:
        return
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
            or info.st_mode & 0o022):
        raise RuntimeError(f'{directory}: expected root-owned, non-writable directory')
    endpoint = directory / 'system_bus_socket'
    try:
        info = endpoint.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1:
        raise RuntimeError(f'{endpoint}: unexpected type, owner, or link count')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
        probe.settimeout(1)
        try:
            probe.connect(str(endpoint))
        except OSError as error:
            if error.errno != errno.ECONNREFUSED:
                raise RuntimeError(f'{endpoint}: cannot establish staleness: {error}') from error
        else:
            raise RuntimeError(f'{endpoint}: system bus is already listening')
    # dbus-daemon replaces stale sockets itself; no manual unlink is needed.


def main():
    if len(sys.argv) != 1:
        raise RuntimeError('no arguments accepted')
    check_socket()
    machine_id = Path('/var/lib/dbus/machine-id')
    if not machine_id.is_file() or machine_id.stat().st_size == 0:
        raise RuntimeError('missing /var/lib/dbus/machine-id; provision it offline')
    os.execv('/usr/x86_64-pc-linux-gnu/bin/dbus-daemon',
             ['dbus-daemon', '--system', '--nofork', '--nopidfile', '--print-address=4'])


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(f'console-dbus: {error}', file=sys.stderr)
        sys.exit(1)
