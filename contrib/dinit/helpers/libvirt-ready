#!/usr/bin/python3
"""Wait for a libvirt daemon to answer on its socket."""
import os
import subprocess
import sys
import time

os.environ['PATH'] = '/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin'
if len(sys.argv) != 2 or sys.argv[1] not in ('virtlogd', 'virtlockd'):
    sys.exit(2)
daemon = sys.argv[1]
for attempt in range(10):
    try:
        status = subprocess.run([
            'timeout', '2', 'virt-admin', '--connect',
            f'{daemon}:///system', 'server-list',
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    except OSError:
        status = 1
    if status == 0:
        sys.exit(0)
    time.sleep(0.2)
print(f'{daemon} admin socket did not become ready', file=sys.stderr)
sys.exit(1)
