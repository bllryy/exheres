#!/usr/bin/python3
"""Run a command with the user bus address set from its runtime directory."""
import os
import sys

runtime = os.environ.get('XDG_RUNTIME_DIR', '')
if not runtime.startswith('/'):
    print('user-bus-env: XDG_RUNTIME_DIR must be absolute', file=sys.stderr)
    sys.exit(1)
if not os.path.isdir(runtime):
    print('user-bus-env: XDG_RUNTIME_DIR must exist', file=sys.stderr)
    sys.exit(1)
if len(sys.argv) == 1:
    print('user-bus-env: command required', file=sys.stderr)
    sys.exit(1)
os.environ['DBUS_SESSION_BUS_ADDRESS'] = f'unix:path={runtime}/bus'
try:
    os.execvp(sys.argv[1], sys.argv[1:])
except FileNotFoundError:
    sys.exit(127)
except OSError as error:
    print(error, file=sys.stderr)
    sys.exit(126)
