set -eu
PATH=/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin
export PATH

if [ "$#" -ne 0 ]; then
    printf '%s\n' 'console-local-mounts: no arguments accepted' >&2
    exit 2
fi

printf '%s\n' 'console-local-mounts: start'
status=0
mount -a -t nosysfs,nonfs,nonfs4,nosmbfs,nocifs -O no_netdev || status=$?
printf '%s\n' "console-local-mounts: complete status=$status"
exit "$status"
