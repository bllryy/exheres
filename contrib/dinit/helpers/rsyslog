#!/usr/bin/env python3
"""Start rsyslog with a private service log socket."""
import os
import sys

BINARY = '/usr/x86_64-pc-linux-gnu/bin/rsyslogd'
ARGV = [BINARY, '-n', '-i', '/run/rsyslogd.pid', '-f', '/etc/dinit.d/rsyslog.conf']


def main():
    if os.path.lexists('/dev/log'):
        raise RuntimeError('/dev/log already exists; stop competing logger/socket before starting rsyslog')
    os.execv(BINARY, ARGV)


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(str(error))
