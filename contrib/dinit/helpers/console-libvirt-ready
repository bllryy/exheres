#!/bin/sh
set -eu
PATH=/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin
export PATH
[ "$#" -eq 1 ] || exit 2
case "$1" in
    virtlogd|virtlockd) daemon=$1 ;;
    *) exit 2 ;;
esac
attempt=0
while [ "$attempt" -lt 10 ]; do
    if timeout 2 virt-admin --connect "$daemon:///system" server-list >/dev/null 2>&1; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 0.2
done
printf '%s\n' "$daemon admin socket did not become ready" >&2
exit 1
