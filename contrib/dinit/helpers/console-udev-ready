#!/bin/sh
# Retry socket creation races; bound both each request and total elapsed time.
set -eu
PATH=/usr/x86_64-pc-linux-gnu/bin:/usr/bin:/bin
export PATH
[ "$#" -eq 0 ] || { printf '%s\n' 'console-udev-ready: no arguments accepted' >&2; exit 1; }
# timeout returns nonzero on exhaustion, so dependent services cannot start.
exec timeout --signal=KILL 30 sh -c '
    until timeout --signal=KILL 2 udevadm control --timeout=1 --ping; do
        sleep 0.2
    done
'
