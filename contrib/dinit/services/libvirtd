type = process
command = /usr/x86_64-pc-linux-gnu/bin/libvirtd
depends-on = local-mounts
depends-on = dbus-ready
depends-on = virtlogd-ready
depends-on = virtlockd-ready
# Do not signal guests in the daemon's process group.
options = signal-process-only
restart = true
log-type = buffer
log-buffer-size = 65536
