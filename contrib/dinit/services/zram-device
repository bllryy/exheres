# Adapted from chimera-linux/dinit-chimera services/zram-device.
# Device setup and swap share one service so reset cannot precede swapoff.
type = scripted
command = /etc/dinit.d/helpers/zram.sh start $1
stop-command = /etc/dinit.d/helpers/zram.sh stop $1
depends-on = udev-settle
start-timeout = 120
stop-timeout = 0
